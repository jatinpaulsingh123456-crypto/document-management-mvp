project_name          = "document-management-mvp"
aws_region            = "eu-west-2"
vpc_cidr              = "10.20.0.0/16"
public_subnet_cidr    = "10.20.1.0/24"
instance_type         = "t3.small"
root_volume_size_gb   = 30
storage_volume_size_gb = 50

# Existing EC2 key-pair name in AWS.
ssh_key_name = "REPLACE_WITH_YOUR_KEY_PAIR"

# Restrict SSH to your public IP. Example:
# admin_cidr_blocks = ["203.0.113.10/32"]
admin_cidr_blocks = ["REPLACE_WITH_YOUR_PUBLIC_IP/32"]

# Git repository containing the MVP.
repo_url = "https://github.com/REPLACE_WITH_YOUR_ACCOUNT/REPLACE_WITH_YOUR_REPO.git"

repo_dir = "/opt/document-management-mvp"
